APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime updates in the browser. `reverb` needs `php artisan reverb:start` running
# (docs/deployment.md, "Reverb"); `null` turns them off (then leave REVERB_APP_KEY empty too, so the browser does not dial).
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=mycic-local
REVERB_APP_KEY=mycic-local-key
REVERB_APP_SECRET=mycic-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Production: REVERB_SERVER_HOST=127.0.0.1 behind nginx (wss), the site's host here,
# and REVERB_APP_RATE_LIMITING_ENABLED=true (docs/deployment.md, "Reverb").
REVERB_ALLOWED_ORIGINS=*

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
# Horizon runs the queues and needs Redis (REDIS_* below).
QUEUE_CONNECTION=redis
# Must stay above the longest job timeout (SyncPortalArchiveJob: 1800 s). It is also how
# long a job left reserved by a crashed worker waits before it is retried.
REDIS_QUEUE_RETRY_AFTER=1900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# NIMs (comma-separated) that may open /horizon and /log-viewer outside APP_ENV=local.
PORTAL_MAINTAINERS=

# Mode demo lokal: tombol "Masuk sebagai mahasiswa demo" di halaman login, tanpa akun CIC. Semua halaman
# portal dijawab dari tests/Fixtures/portal, portal kampus tidak pernah dihubungi. Hanya berlaku saat APP_ENV=local.
PORTAL_DEMO=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CIC Campus Configuration
CAMPUS_BASE_URL="https://my.cic.ac.id"
CAMPUS_LOGIN_URL="https://my.cic.ac.id/portal/mahasiswa/"
CAMPUS_LOGIN_ACTION="https://my.cic.ac.id/portal/mahasiswa/?mod=loginact"
CAMPUS_DASHBOARD_URL="https://my.cic.ac.id/portal/mahasiswa/?mod=student&act=dashboard"
CAMPUS_SIPANDAI_ASSIGNMENT_URL="https://my.cic.ac.id/portal/sipandai/?mod=sipandai&act=send"
CAMPUS_SIPANDAI_ATTENDANCE_URL="https://my.cic.ac.id/portal/sipandai/views/validasi/demo.php"
CAMPUS_REQUEST_TIMEOUT=25
CAMPUS_WEB_REQUEST_TIMEOUT=15
CAMPUS_REQUEST_DELAY=1000
CAMPUS_SECURE_DNS_URL="https://chrome.cloudflare-dns.com/dns-query"
# Campus file downloads (/api/support/download) are streamed with their own limits.
CAMPUS_DOWNLOAD_TIMEOUT=120
CAMPUS_DOWNLOAD_READ_TIMEOUT=30
CAMPUS_DOWNLOAD_MAX_BYTES=52428800

# Session Management
CAMPUS_SESSION_PREFIX="cic_session_"
CAMPUS_AUTO_RELOGIN=false
CAMPUS_AUTO_RELOGIN_CREDENTIAL_TTL=900
CAMPUS_SESSION_REFRESH_INTERVAL=1200
CAMPUS_SESSION_IDLE_TIMEOUT=7200
CAMPUS_LOGIN_RATE_LIMIT_ATTEMPTS=5
CAMPUS_LOGIN_RATE_LIMIT_DECAY=300
CAMPUS_ACTION_RATE_LIMIT_ATTEMPTS=10
CAMPUS_ACTION_RATE_LIMIT_DECAY=60
# Failed logins per IP within CAMPUS_LOGIN_RATE_LIMIT_DECAY (raise it for a large campus NAT).
CAMPUS_LOGIN_FAILURE_ATTEMPTS_PER_IP=30
# Class, meeting and flow reads per minute per campus session.
CAMPUS_READ_RATE_LIMIT_ATTEMPTS=60
# Realtime channel sign-ins (broadcasting/auth) per minute per campus session.
CAMPUS_CHANNEL_AUTH_RATE_LIMIT_ATTEMPTS=30
# Address or CIDR of the reverse proxy / load balancer / CDN in front of MyCIC ('*' only when every
# request arrives through it). Leave empty when clients reach the server directly: they could forge
# X-Forwarded-For. Behind a proxy without it, all students share one per-IP login-failure budget.
TRUSTED_PROXIES=

# Archive, offline login and background sync
# PORTAL_BACKGROUND_SYNC_ENABLED alone decides whether students' portal username and password are
# stored (encrypted with APP_KEY); PORTAL_ARCHIVE_OFFLINE_LOGIN=false only stops offline login.
PORTAL_ARCHIVE_OFFLINE_LOGIN=true
PORTAL_ARCHIVE_OFFLINE_LOGIN_DAYS=30
PORTAL_BACKGROUND_SYNC_ENABLED=true
# Secret each student's archive is keyed by; empty uses APP_KEY. Set it to the current APP_KEY
# value BEFORE rotating APP_KEY, or every student's archive, offline login and notebooks are
# orphaned. Earlier owner secrets (comma separated; APP_PREVIOUS_KEYS are tried too) are moved
# to the current one at each student's next login.
PORTAL_OWNER_KEY=
PORTAL_PREVIOUS_OWNER_KEYS=

# Debug: keep sanitized copies of the portal's answers to write actions (attendance, assignment
# upload/delete, exam upload) and of the pages read to verify them, for real test fixtures.
# Never records in production unless PORTAL_DEBUG_ALLOW_IN_PRODUCTION=true as well.
# Empty PORTAL_CAPTURE_PATH uses storage/app/portal-captures.
PORTAL_RECORD_ACTION_RESPONSES=false
PORTAL_DEBUG_ALLOW_IN_PRODUCTION=false
PORTAL_CAPTURE_PATH=

# Cache Configuration
CAMPUS_CACHE_PROFILE_TTL=600
CAMPUS_CACHE_DYNAMIC_TTL=300
CAMPUS_CACHE_HTML_TTL=300

# Notebook (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT=60
# Seconds a web request may spend on all Gemini attempts (keep under the web server timeout, nginx: 60).
GEMINI_REQUEST_BUDGET=50
# Seconds a queued PDF/image read may spend.
GEMINI_INGEST_BUDGET=240
NOTEBOOK_DAILY_REQUESTS=60
# Of the daily source reads, those kept for files the student adds themselves.
NOTEBOOK_RESERVED_SOURCE_READS=10
# Readings queued at a time per notebook (course files and the student's own picks); the rest follow as these finish.
NOTEBOOK_QUEUED_READINGS=4
# Tokens Gemini may spend thinking per answer (0 = off where the model allows, -1 = model decides); empty = model default.
NOTEBOOK_THINKING_BUDGET=

# Mobile app: bearer tokens unused this many days are pruned; push tokens the app has not registered again are pruned after PORTAL_PUSH_TOKEN_RETENTION_DAYS.
PORTAL_MOBILE_TOKEN_RETENTION_DAYS=30
PORTAL_PUSH_TOKEN_RETENTION_DAYS=60
# Deadline and class-started pushes while the app is closed, from snapshots at most this many seconds old.
PORTAL_AWAY_REMINDERS_ENABLED=true
PORTAL_AWAY_REMINDER_MAX_DATA_AGE=86400
# Expo push service (notifications to the app). The access token is only needed when the Expo project enforces push security.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
EXPO_PUSH_TIMEOUT=15

# Sentry error and performance reporting (the mycic-web project). Empty DSN: nothing is sent.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=false
# Sentry Logs: also add sentry_logs to LOG_STACK (e.g. LOG_STACK=single,sentry_logs).
SENTRY_ENABLE_LOGS=false
SENTRY_LOG_LEVEL=info
