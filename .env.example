APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=mycic-local
REVERB_APP_KEY=mycic-local-key
REVERB_APP_SECRET=mycic-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CIC Campus Configuration
CAMPUS_BASE_URL="https://my.cic.ac.id"
CAMPUS_LOGIN_URL="https://my.cic.ac.id/portal/mahasiswa/"
CAMPUS_LOGIN_ACTION="https://my.cic.ac.id/portal/mahasiswa/?mod=loginact"
CAMPUS_DASHBOARD_URL="https://my.cic.ac.id/portal/mahasiswa/?mod=student&act=dashboard"
CAMPUS_SIPANDAI_ASSIGNMENT_URL="https://my.cic.ac.id/portal/sipandai/?mod=sipandai&act=send"
CAMPUS_SIPANDAI_ATTENDANCE_URL="https://my.cic.ac.id/portal/sipandai/views/validasi/demo.php"
CAMPUS_REQUEST_TIMEOUT=25
CAMPUS_WEB_REQUEST_TIMEOUT=15
CAMPUS_REQUEST_DELAY=1000
CAMPUS_SECURE_DNS_URL="https://chrome.cloudflare-dns.com/dns-query"

# Session Management
CAMPUS_SESSION_PREFIX="cic_session_"
CAMPUS_AUTO_RELOGIN=false
CAMPUS_AUTO_RELOGIN_CREDENTIAL_TTL=900
CAMPUS_SESSION_REFRESH_INTERVAL=1200
CAMPUS_SESSION_IDLE_TIMEOUT=7200
CAMPUS_LOGIN_RATE_LIMIT_ATTEMPTS=5
CAMPUS_LOGIN_RATE_LIMIT_DECAY=300
CAMPUS_ACTION_RATE_LIMIT_ATTEMPTS=10
CAMPUS_ACTION_RATE_LIMIT_DECAY=60

# Cache Configuration
CAMPUS_CACHE_PROFILE_TTL=600
CAMPUS_CACHE_DYNAMIC_TTL=300
CAMPUS_CACHE_HTML_TTL=300
