			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status === 'success' && response.data.session_token) {",
									"        pm.collectionVariables.set('sessionId', response.data.session_token);",
									"        pm.collectionVariables.set('userInfo', JSON.stringify(response.data.user_info));",
									"        pm.test('Login successful', () => {",
									"            pm.expect(response.status).to.eql('success');",
									"            pm.expect(response.data.session_token).to.be.a('string');",
									"        });",
									"    }",
									"} else {",
									"    pm.test('Login failed', () => {",
									"        pm.expect(pm.response.code).to.be.oneOf([401, 422]);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
