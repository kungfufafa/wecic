{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apriansyahrs/mycic",
    "type": "project",
    "description": "MyCIC: a Laravel application in front of the CIC student portal, served as a JSON API and a web dashboard.",
    "keywords": ["laravel", "cic", "campus-portal", "scraping"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.12.35",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "opcodesio/log-viewer": "^3.24",
        "sentry/sentry-laravel": "^4.29",
        "symfony/dom-crawler": "^7.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^1.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "rector/rector": "^2.7",
        "tomasvotruba/unused-public": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#86efac\" \"php artisan serve\" \"php artisan horizon:listen\" \"php artisan reverb:start\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,reverb,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=2G",
        "analyse:baseline": "vendor/bin/phpstan analyse --no-progress --memory-limit=2G --generate-baseline phpstan-baseline.neon",
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pint --test",
            "npm run test:js",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=log-viewer-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "First run: install PHP and npm dependencies, create .env and APP_KEY, migrate, build the frontend.",
        "dev": "Run the app server, Horizon, Reverb, Pail and Vite together.",
        "test": "Run the PHP test suite after clearing the config cache.",
        "analyse": "Run Larastan; only errors missing from phpstan-baseline.neon are reported.",
        "analyse:baseline": "Regenerate phpstan-baseline.neon from the errors Larastan reports now.",
        "check": "Everything CI checks, fastest first: Pint, Node tests, Larastan, PHP tests. Stops at the first failure."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
