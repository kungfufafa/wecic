# Browser tests (tests/e2e, `npm run test:e2e`). Playwright starts
# `php artisan serve` with APP_ENV=e2e, which loads this file instead of .env.
# It keeps the e2e server away from everything real: no campus portal (every
# portal URL points at a reserved, unroutable host and bootstrap/e2e.php
# refuses portal requests), no development database, no queue, no Reverb, no
# Vite dev server (bootstrap/e2e.php: pages load public/build), and no writes
# to storage/logs/laravel.log. routes/e2e.php adds the fake sign-in the specs
# use. The key below signs e2e cookies only; never reuse it.
APP_NAME=Laravel
APP_ENV=e2e
APP_KEY=base64:UgXkKaX8CH49N0C0zUCWq4+R/wZbsOsOg9A3seFHtMI=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Three signed-in tabs load at once.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL='"null"'

# A database nothing reads from: the pages the specs open keep their state in
# the session and the cache below, and every /api/* request is mocked in the
# browser.
DB_CONNECTION=sqlite
DB_DATABASE=":memory:"

# The app session lives in the browser's cookies, so a run leaves no session
# files behind.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

CACHE_STORE=file

# "null" quoted, or env() would read it as null: jobs are dropped, broadcasts go nowhere.
QUEUE_CONNECTION='"null"'
BROADCAST_CONNECTION='"null"'

MAIL_MAILER=array

# Laravel Boost would inject its browser logger into every page and append the
# specs' console output to storage/logs/browser.log.
BOOST_ENABLED=false

CAMPUS_BASE_URL="https://portal.invalid"
CAMPUS_LOGIN_URL="https://portal.invalid/portal/mahasiswa/"
CAMPUS_LOGIN_ACTION="https://portal.invalid/portal/mahasiswa/?mod=loginact"
CAMPUS_DASHBOARD_URL="https://portal.invalid/portal/mahasiswa/?mod=student&act=dashboard"
CAMPUS_SIPANDAI_ASSIGNMENT_URL="https://portal.invalid/portal/sipandai/?mod=sipandai&act=send"
CAMPUS_SIPANDAI_ATTENDANCE_URL="https://portal.invalid/portal/sipandai/views/validasi/demo.php"
CAMPUS_SECURE_DNS_URL=""
CAMPUS_SESSION_PREFIX="e2e_cic_session_"
CAMPUS_AUTO_RELOGIN=false

GEMINI_API_KEY=""
