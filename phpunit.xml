<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- The `null` log channel, so tests never write to storage/logs/laravel.log. Quoted: a bare null would make env() return null. -->
        <env name="LOG_CHANNEL" value='"null"'/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Tests never reach the real portal: every portal URL .env sets points at a reserved, unroutable host (tests/TestCase.php refuses the rest), and no lookup goes through the DNS-over-HTTPS resolver. -->
        <env name="CAMPUS_BASE_URL" value="https://portal.invalid" force="true"/>
        <env name="CAMPUS_LOGIN_URL" value="https://portal.invalid/portal/mahasiswa/" force="true"/>
        <env name="CAMPUS_LOGIN_ACTION" value="https://portal.invalid/portal/mahasiswa/?mod=loginact" force="true"/>
        <env name="CAMPUS_DASHBOARD_URL" value="https://portal.invalid/portal/mahasiswa/?mod=student&amp;act=dashboard" force="true"/>
        <env name="CAMPUS_SIPANDAI_ASSIGNMENT_URL" value="https://portal.invalid/portal/sipandai/?mod=sipandai&amp;act=send" force="true"/>
        <env name="CAMPUS_SIPANDAI_ATTENDANCE_URL" value="https://portal.invalid/portal/sipandai/views/validasi/demo.php" force="true"/>
        <env name="CAMPUS_SECURE_DNS_URL" value="" force="true"/>
        <env name="PORTAL_DEMO" value="false" force="true"/>
        <!-- No real Gemini key: a test that needs one sets services.gemini.key and fakes the HTTP calls. -->
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <!-- Tests never report to Sentry, whatever DSN the checkout's .env has. -->
        <env name="SENTRY_LARAVEL_DSN" value="null" force="true"/>
        <!-- Broadcasts go nowhere (quoted, like LOG_CHANNEL); PortalBroadcastingTest boots with the reverb broadcaster it tests. -->
        <env name="BROADCAST_CONNECTION" value='"null"' force="true"/>
        <env name="REVERB_APP_ID" value="mycic-test"/>
        <env name="REVERB_APP_KEY" value="mycic-test-key"/>
        <env name="REVERB_APP_SECRET" value="mycic-test-secret"/>
        <env name="REVERB_HOST" value="127.0.0.1"/>
        <env name="REVERB_PORT" value="8080"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
