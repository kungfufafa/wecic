# Origin of the MyCIC server (no /api suffix). Copy to .env.local.
# A simulator reaches Laravel Herd at http://mycic.test; a phone needs an address it can reach.
EXPO_PUBLIC_API_URL=http://mycic.test

# DSN of the wecic-mobile Sentry project (Settings → Client Keys). Empty: nothing is sent.
EXPO_PUBLIC_SENTRY_DSN=
# Lets release builds upload source maps and debug symbols. Never commit it; for EAS, set it as an EAS secret.
# SENTRY_AUTH_TOKEN=
